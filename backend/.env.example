# Local development database and browser origin.
DB_URL=jdbc:postgresql://localhost:5432/jobstar
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# Supabase Storage S3 configuration. Keep these server-only values private.
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your-project-region
SUPABASE_STORAGE_ACCESS_KEY=replace-with-your-s3-access-key
SUPABASE_STORAGE_SECRET_KEY=replace-with-your-s3-secret-key
SUPABASE_STORAGE_BUCKET=resumes
