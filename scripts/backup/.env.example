# Copy to backend/.env.backup. This file is NOT read by the JobStar app.
# Plain KEY=value format, without quotation marks. Passwords are separate values.
PG_BIN=C:\Program Files\PostgreSQL\18\bin
BACKUP_DB_HOST=aws-0-us-west-2.pooler.supabase.com
BACKUP_DB_PORT=5432
BACKUP_DB_NAME=postgres
BACKUP_DB_USER=postgres.xlbhhahosuahvhgikibd
BACKUP_DB_PASSWORD=REPLACE_WITH_SUPABASE_DATABASE_PASSWORD
BACKUP_DB_SSLMODE=require

# Existing S3 settings are read from backend/.env. Override here only if needed.
# SUPABASE_STORAGE_ENDPOINT=https://YOUR_PROJECT.storage.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_REGION=YOUR_REGION
# SUPABASE_STORAGE_ACCESS_KEY=YOUR_S3_ACCESS_KEY
# SUPABASE_STORAGE_SECRET_KEY=YOUR_S3_SECRET_KEY
# SUPABASE_STORAGE_BUCKET=resumes

# Restore is restricted to a NEW local database with the jobstar_recovery_ prefix.
RESTORE_DB_HOST=127.0.0.1
RESTORE_DB_PORT=5432
RESTORE_DB_USER=postgres
RESTORE_DB_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
